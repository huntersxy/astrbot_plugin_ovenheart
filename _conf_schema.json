{
  "enabled": {
    "description": "启用人格工坊",
    "type": "bool",
    "default": true
  },
  "learning_enabled": {
    "description": "启用素材采集与学习",
    "type": "bool",
    "default": true
  },
  "apply_enabled": {
    "description": "应用人格与学习结果",
    "type": "bool",
    "default": true
  },
  "learning_review_enabled": {
    "description": "学习结果入库自检",
    "type": "bool",
    "default": true,
    "hint": "提取后用同一学习模型核对原文与情境。未通过的新候选转待审，未通过的合并不修改旧条目；自检失败保留整批素材。通常增加一次后台调用，与提取及格式纠正共享90秒预算。"
  },
  "guidance_delivery": {
    "description": "提示投递方式",
    "type": "string",
    "default": "system",
    "options": ["system", "dual"],
    "hint": "system 仅补充系统提示词；dual 同时把当前角色与已选习惯作为临时用户上下文，适合 system 不生效的接口。不会复制整段宿主系统提示词。"
  },
  "activation_mode": {
    "description": "新结果生效方式",
    "type": "string",
    "default": "review",
    "options": [
      "review",
      "auto"
    ],
    "hint": "review 为先审核后生效，auto 为高置信度自动生效。原生 Panel 中保存的设置优先。"
  },
  "auto_confidence": {
    "description": "自动生效最低置信度",
    "type": "float",
    "default": 0.9
  },
  "min_evidence": {
    "description": "每条学习结果最少证据消息数",
    "type": "int",
    "default": 2
  },
  "min_messages": {
    "description": "自动学习素材门槛",
    "type": "int",
    "default": 12
  },
  "batch_size": {
    "description": "每批最多素材消息数",
    "type": "int",
    "default": 30
  },
  "interval_seconds": {
    "description": "每会话学习与重试间隔（秒）",
    "type": "int",
    "default": 600
  },
  "provider_id": {
    "description": "学习模型提供商 ID",
    "type": "string",
    "default": "",
    "hint": "留空使用该会话当前模型；填写 AstrBot 已配置的提供商 ID。"
  },
  "target_senders": {
    "description": "只向这些用户学习",
    "type": "list",
    "default": [],
    "hint": "用户 ID 列表；留空向允许会话内除机器人自身以外的发送者学习。指定对象后，旁人的邻近发言仅在短暂内存中帮助理解语境，不入素材库或证据。"
  },
  "allowed_sessions": {
    "description": "允许学习和应用的会话",
    "type": "list",
    "default": [],
    "hint": "完整 unified_msg_origin 列表，可通过 /sid 获取。留空允许全部已启用会话。"
  },
  "learn_personality": {
    "description": "学习人格倾向",
    "type": "bool",
    "default": true
  },
  "learn_expression": {
    "description": "学习表达方式",
    "type": "bool",
    "default": true
  },
  "learn_jargon": {
    "description": "学习群聊词汇",
    "type": "bool",
    "default": true
  },
  "learn_behavior": {
    "description": "学习行为策略",
    "type": "bool",
    "default": true
  },
  "memory_enabled": {
    "description": "参考 LivingMemory 记忆",
    "type": "bool",
    "default": true
  },
  "memory_top_k": {
    "description": "每批最多参考记忆数",
    "type": "int",
    "default": 3
  },
  "prompt_budget": {
    "description": "补充提示词字符上限",
    "type": "int",
    "default": 3000
  },
  "max_traits": {
    "description": "每次最多应用习惯数",
    "type": "int",
    "default": 8
  },
  "retention_days": {
    "description": "原始素材保留天数",
    "type": "int",
    "default": 14
  },
  "max_messages_per_scope": {
    "description": "每会话原始素材数量上限",
    "type": "int",
    "default": 300
  },
  "embedding_provider_id": {
    "description": "表达检索向量模型 ID",
    "type": "string",
    "default": "",
    "hint": "填写 AstrBot 已配置的 embedding 提供商 ID；留空回退文字相关性。"
  },
  "retrieval_timeout": {
    "description": "向量与重排序总超时（秒）",
    "type": "int",
    "default": 6
  },
  "selection_mode": {
    "description": "习惯检索方式",
    "type": "string",
    "default": "contextual",
    "options": [
      "contextual",
      "hybrid",
      "lexical"
    ]
  },
  "selector_timeout": {
    "description": "情境筛选等待上限（秒）",
    "type": "int",
    "default": 12,
    "hint": "情境模式每次回复最多额外调用一次学习模型，未指定时使用当前聊天模型；超时沿用人格底稿，本轮不追加学习条目。"
  },
  "rerank_provider_id": {
    "description": "习惯重排序提供商 ID",
    "type": "string",
    "default": "",
    "hint": "填写 AstrBot 已配置的 rerank 提供商 ID；留空跳过。模型相关性不能代替情境适用判断。"
  },
  "semantic_threshold": {
    "description": "语义相关性门槛",
    "type": "float",
    "default": 0.25,
    "hint": "余弦相似度门槛，需按向量模型与实际会话调整。"
  },
  "habit_half_life": {
    "description": "习惯新鲜度半衰期（天）",
    "type": "int",
    "default": 90,
    "hint": "长期未再观察的习惯逐渐降权，保留条目且不自动删除。"
  },
  "participation_mode": {
    "description": "自主参与方式",
    "type": "string",
    "default": "off",
    "options": [
      "off",
      "observe",
      "auto"
    ],
    "hint": "off 关闭；observe 仅记录决策；auto 自主参与群聊。私聊、命令和直接唤醒不受影响。"
  },
  "participation_min_messages": {
    "description": "参与决策最少新消息",
    "type": "int",
    "default": 3
  },
  "participation_debounce": {
    "description": "群聊输入合并等待（秒）",
    "type": "int",
    "default": 2
  },
  "participation_cooldown": {
    "description": "自主参与冷却（秒）",
    "type": "int",
    "default": 90
  },
  "participation_hourly_limit": {
    "description": "每会话每小时自主参与上限",
    "type": "int",
    "default": 12
  },
  "planner_provider_id": {
    "description": "参与决策模型 ID",
    "type": "string",
    "default": "",
    "hint": "留空使用学习模型或当前会话模型。"
  },
  "planner_timeout": {
    "description": "参与决策请求超时（秒）",
    "type": "int",
    "default": 20
  },
  "planner_reply_threshold": {
    "description": "自主参与最低置信度",
    "type": "float",
    "default": 0.7
  },
  "planner_max_wait": {
    "description": "决策最长等待（秒）",
    "type": "int",
    "default": 30
  },
  "autonomous_tools": {
    "description": "自主回复允许使用的工具",
    "type": "list",
    "default": [],
    "hint": "工具名称列表；默认仅文字回复。只限制自主参与，直接唤醒仍使用原有工具策略。"
  }
}
