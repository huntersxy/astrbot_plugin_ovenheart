{
  "enabled": {
    "description": "启用人格工坊",
    "type": "bool",
    "default": true
  },
  "learning_enabled": {
    "description": "启用素材采集与学习",
    "type": "bool",
    "default": true
  },
  "apply_enabled": {
    "description": "应用人格与学习结果",
    "type": "bool",
    "default": true
  },
  "activation_mode": {
    "description": "新结果生效方式",
    "type": "string",
    "default": "review",
    "options": [
      "review",
      "auto"
    ],
    "hint": "review 为先审核后生效，auto 为高置信度自动生效。原生 Panel 中保存的设置优先。"
  },
  "auto_confidence": {
    "description": "自动生效最低置信度",
    "type": "float",
    "default": 0.9
  },
  "min_evidence": {
    "description": "每条学习结果最少证据消息数",
    "type": "int",
    "default": 2
  },
  "min_messages": {
    "description": "自动学习素材门槛",
    "type": "int",
    "default": 12
  },
  "batch_size": {
    "description": "每批最多素材消息数",
    "type": "int",
    "default": 30
  },
  "interval_seconds": {
    "description": "每会话学习与重试间隔（秒）",
    "type": "int",
    "default": 600
  },
  "provider_id": {
    "description": "学习模型提供商 ID",
    "type": "string",
    "default": "",
    "hint": "留空使用该会话当前模型；填写 AstrBot 已配置的提供商 ID。"
  },
  "target_senders": {
    "description": "只向这些用户学习",
    "type": "list",
    "default": [],
    "hint": "用户 ID 列表；留空向允许会话内除机器人自身以外的发送者学习。"
  },
  "allowed_sessions": {
    "description": "允许学习和应用的会话",
    "type": "list",
    "default": [],
    "hint": "完整 unified_msg_origin 列表，可通过 /sid 获取。留空允许全部已启用会话。"
  },
  "learn_personality": {
    "description": "学习人格倾向",
    "type": "bool",
    "default": true
  },
  "learn_expression": {
    "description": "学习表达方式",
    "type": "bool",
    "default": true
  },
  "learn_jargon": {
    "description": "学习群聊词汇",
    "type": "bool",
    "default": true
  },
  "learn_behavior": {
    "description": "学习行为策略",
    "type": "bool",
    "default": true
  },
  "memory_enabled": {
    "description": "参考 LivingMemory 记忆",
    "type": "bool",
    "default": true
  },
  "memory_top_k": {
    "description": "每批最多参考记忆数",
    "type": "int",
    "default": 3
  },
  "prompt_budget": {
    "description": "补充提示词字符上限",
    "type": "int",
    "default": 3000
  },
  "max_traits": {
    "description": "每次最多应用习惯数",
    "type": "int",
    "default": 8
  },
  "retention_days": {
    "description": "原始素材保留天数",
    "type": "int",
    "default": 14
  },
  "max_messages_per_scope": {
    "description": "每会话原始素材数量上限",
    "type": "int",
    "default": 300
  },
  "embedding_provider_id": {
    "description": "表达检索向量模型 ID",
    "type": "string",
    "default": "",
    "hint": "填写 AstrBot 已配置的 embedding 提供商 ID；留空回退文字相关性。"
  },
  "retrieval_timeout": {
    "description": "语义检索总超时（秒）",
    "type": "int",
    "default": 6
  },
  "selection_mode": {
    "description": "习惯检索方式",
    "type": "string",
    "default": "hybrid",
    "options": [
      "hybrid",
      "lexical"
    ]
  },
  "semantic_threshold": {
    "description": "语义相关性门槛",
    "type": "float",
    "default": 0.25,
    "hint": "余弦相似度门槛，需按向量模型与实际会话调整。"
  },
  "habit_half_life": {
    "description": "习惯新鲜度半衰期（天）",
    "type": "int",
    "default": 90,
    "hint": "长期未再观察的习惯逐渐降权，保留条目且不自动删除。"
  }
}
